# Porta do servidor (padrão 3000 se omitido)
PORT=sua-porta-de-uso

# Chave secreta para assinatura dos tokens JWT (pode ser qualquer string segura em desenvolvimento)
JWT_SECRET=sua-chave-aqui

# Conexão com o MongoDB (ajuste conforme seu banco local ou MongoDB Atlas)
MONGODB_URI=mongodb://seu-domínio/banco